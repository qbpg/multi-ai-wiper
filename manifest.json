{
  "manifest_version": 3,
  "name": "Multi-AI Wiper Tool",
  "version": "1.0.0",
  "description": "Bulk-delete conversations from Gemini, Claude, ChatGPT, DeepSeek & Mistral — 100% local, zero telemetry.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Quick-delete conversations on current tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
